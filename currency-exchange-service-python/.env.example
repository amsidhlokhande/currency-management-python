# ========================================================
# Currency Exchange Service (.env.example)
# ========================================================

# Service Metadata & Context Path
SERVICE_NAME=currency-exchange-service-python
PORT=8000
ENV=development
LOG_LEVEL=INFO
CONTEXT_PATH=/currency-exchange-service-python

# Rate Ingestion Configuration (Dual Mode)
# When deployed on Windows: C:\rates\exchange_rates.csv
# When deployed on Cloud Run: s3://currency-rates-bucket/exchange_rates.csv
RATES_CSV_PATH=C:\rates\exchange_rates.csv

# AWS Configuration (for S3 mode)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Error Codes & Functional Error Messages (Driven through constants.py)
CESP_ERR_RATE_NOT_FOUND_CODE=CESP_001
CESP_ERR_RATE_NOT_FOUND_MSG=Exchange rate not available for the requested currency pair.

CESP_ERR_INVALID_CURRENCY_CODE=CESP_002
CESP_ERR_INVALID_CURRENCY_MSG=Currency code must be a valid 3-letter ISO 4217 alphabetic code.

CESP_ERR_DATA_INGESTION_CODE=CESP_003
CESP_ERR_DATA_INGESTION_MSG=Unable to load currency exchange rate dataset from configured source.

CESP_ERR_INTERNAL_SERVER_CODE=CESP_500
CESP_ERR_INTERNAL_SERVER_MSG=An internal processing error occurred in Currency Exchange Service.
