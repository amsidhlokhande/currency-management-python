# ========================================================
# Currency Conversion Service (.env.example)
# ========================================================

# Service Metadata & Context Path
SERVICE_NAME=currency-conversion-service-python
PORT=8100
ENV=development
LOG_LEVEL=INFO
CONTEXT_PATH=/currency-conversion-service-python

# Downstream Currency Exchange Service Configuration (including its context path)
EXCHANGE_SERVICE_URL=http://localhost:8000/currency-exchange-service-python

# Resilient HTTP Client Parameters
HTTP_TIMEOUT_CONNECT=1.5
HTTP_TIMEOUT_READ=3.5
HTTP_MAX_RETRIES=3
GCP_OIDC_AUTH=false

# Error Codes & Functional Error Messages (Driven through constants.py - CCSP taxonomy)
CCSP_ERR_RATE_NOT_FOUND_CODE=CCSP_001
CCSP_ERR_RATE_NOT_FOUND_MSG=Exchange rate not available for the requested currency pair.

CCSP_ERR_INVALID_QUANTITY_CODE=CCSP_002
CCSP_ERR_INVALID_QUANTITY_MSG=Conversion quantity must be a positive numeric value greater than zero.

CCSP_ERR_INVALID_CURRENCY_CODE=CCSP_003
CCSP_ERR_INVALID_CURRENCY_MSG=Currency code must be a valid 3-letter ISO 4217 alphabetic code.

CCSP_ERR_DOWNSTREAM_UNAVAILABLE_CODE=CCSP_004
CCSP_ERR_DOWNSTREAM_UNAVAILABLE_MSG=The downstream Currency Exchange Service is currently unavailable.

CCSP_ERR_INTERNAL_SERVER_CODE=CCSP_500
CCSP_ERR_INTERNAL_SERVER_MSG=An internal processing error occurred in Currency Conversion Service.
